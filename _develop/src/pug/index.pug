extends ./utils/_base.pug

block append stylesheet
  //- assetPathで自動でサブディレクトリ対応の/assets/のパスが出るようにしてあります。
  link(rel="stylesheet", href=assetPath + 'css/index.css')


//- ルートだけは配列不要。base.pugの const url使うので。
block ld
  +breadcrumbList([])


block main

  -
    const thumbList = [
      {
        title: 'カバーフローカルーセル Three.js',
        thumb: 'images/top/cover_flow.jpg',
        link: '/engineer/yamamoto/practice/cover_flow/',
      },
      {
        title: 'd3 を使って折れ線グラフを描画する',
        thumb: 'images/top/d3.svg',
        link: '/engineer/yamamoto/practice/d3/',
      },
      {
        title: 'gsap - 中心に集約するアニメーション',
        thumb: 'images/top/gsap01.jpg',
        link: '/engineer/yamamoto/practice/gsap01/',
      },
      {
        title: 'HTML / CSS / JS サンプル',
        thumb: 'images/top/mock.png',
        link: '/engineer/yamamoto/practice/mock/',
      },
    ]

  .contentInner
    ul.thumbList
      each item in thumbList
        li.thumbList__item
          a(href=item.link).thumbList__item--anchor
            figure.thumbList__item--img
              +img(item.thumb, item.title)
            p.thumbList__item--desc!= item.title
